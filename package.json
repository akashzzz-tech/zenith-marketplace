{
  "name": "zenith-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "ZENITH — Experienced Talent. Remote Opportunities.",
  "workspaces": [
    "web",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "mobile": "npm run start --workspace=mobile",
    "lint": "npm run lint --workspace=web && npm run lint --workspace=mobile",
    "type-check": "npm run type-check --workspace=web && npm run type-check --workspace=mobile",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.types.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^5.0.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
