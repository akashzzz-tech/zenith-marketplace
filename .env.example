# ============================================================
# ZENITH MARKETPLACE — Environment Variables Template
# ============================================================
# Copy this file to .env.local (web) or .env (mobile)
# NEVER commit real secrets to source control.
# ============================================================

# ── SUPABASE ──────────────────────────────────────────────
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  SERVER-SIDE ONLY — Never expose in frontend code or commit to Git
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ── PAYMENT PROVIDERS ──────────────────────────────────────
# ⚠️  EXTERNAL CONFIGURATION REQUIRED
# ⚠️  PAYMENT PROVIDER APPROVAL REQUIRED
# Use ONLY sandbox/test keys during development.
# Never use real money for testing.

# Stripe Connect (US, EU, UK, SG, AU)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Razorpay Marketplace (India)
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_RAZORPAY_TEST_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_RAZORPAY_SECRET


# ── FIREBASE CLOUD MESSAGING ───────────────────────────────
# ⚠️  EXTERNAL CONFIGURATION REQUIRED
# Found in: Firebase Console > Project Settings > Service Accounts
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-side Firebase Admin (for sending push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com


# ── GOOGLE MAPS PLATFORM ────────────────────────────────────
# ⚠️  EXTERNAL CONFIGURATION REQUIRED
# Restrict this API key to your production domain in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key


# ── POSTHOG ANALYTICS ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ── SENTRY ERROR MONITORING ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=zenith-web


# ── APPLICATION ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ZENITH


# ── ACTIVE PAYMENT PROVIDER ─────────────────────────────────
# Set to 'stripe' or 'razorpay' to activate that provider
# The payment abstraction layer uses this to select the implementation
PAYMENT_PROVIDER=stripe
